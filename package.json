{
  "name": "ngp-traffic",
  "version": "3.0.0",
  "description": "Real-time Nagpur live traffic intelligence, routing, and deployment advisory app",
  "main": "server.js",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:cities": "node scripts/validate-cities.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js"
  },
  "keywords": [
    "traffic",
    "nagpur",
    "tomtom",
    "open-meteo",
    "routing",
    "leaflet",
    "socket.io",
    "real-time"
  ],
  "author": "Team NGP-TRAFFIC",
  "license": "MIT",
  "dependencies": {
    "cors": "2.8.6",
    "express": "4.22.3",
    "helmet": "8.3.0",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "typescript": "7.0.2"
  }
}
