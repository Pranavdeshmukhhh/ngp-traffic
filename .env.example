TOMTOM_API_KEY=your_tomtom_api_key_here
PORT=3000
# Number of trusted reverse-proxy hops (0 locally, 1 behind Render/Nginx/Cloudflare)
TRUST_PROXY=0
# Default city id (matches config/cities/<id>.json) and max concurrent active cities
CITY=nagpur
MAX_ACTIVE_CITIES=1
# Optional bearer token to enable GET /api/metrics (disabled / 404 when unset)
METRICS_TOKEN=
