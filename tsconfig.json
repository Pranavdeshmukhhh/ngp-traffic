{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "CommonJS",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false
  },
  "include": [
    "server.js",
    "src/**/*.js",
    "scripts/**/*.js",
    "test/**/*.js",
    "public/js/tile-fallback.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
